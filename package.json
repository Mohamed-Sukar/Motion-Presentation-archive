{
  "name": "motion-presentation-studio",
  "productName": "Motion Presentation Studio",
  "version": "1.4.0",
  "description": "Zero-Flicker Motion Graphics Presentation Studio & Player for PC",
  "author": "Motion Presentation Studio",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc && vite build",
    "build:icons": "node scripts/generate-icons.mjs",
    "pack:win": "npm run build:icons && npm run build && electron-builder --win --dir",
    "dist:win": "npm run build:icons && npm run build && electron-builder --win nsis",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "test": "npx tsx scripts/verify-all.ts",
    "lint": "eslint .",
    "preview": "vite preview --port 5175",
    "electron:dev": "electron .",
    "start": "vite --port 5175 --open"
  },
  "build": {
    "appId": "com.motionpresentation.studio",
    "productName": "Motion Presentation Studio",
    "directories": {
      "output": "../installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "dist/demo/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Motion Presentation Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "fileAssociations": [
      {
        "ext": "mpres",
        "name": "Motion Presentation Project",
        "description": "Motion Presentation Studio Project File",
        "role": "Editor",
        "icon": "build/file-icon.ico"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.1"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide": "^1.73.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
